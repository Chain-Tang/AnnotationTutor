# Keep executable/source text portable even when a checkout uses core.autocrlf.
# This does not renormalize existing files or classify binary assets as text.
*.ts text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.css text eol=lf
*.html text eol=lf
*.svg text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.java text eol=lf
*.kts text eol=lf
*.gradle text eol=lf
*.xml text eol=lf
