{
  "name": "annotation-tutor-lite",
  "version": "0.5.4",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "package": "node scripts/package.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "pnpm typecheck:plugin && pnpm extension:typecheck && pnpm scripts:check",
    "typecheck:plugin": "tsc --noEmit",
    "extension:typecheck": "npm --prefix extension run typecheck",
    "extension:build": "npm --prefix extension run build",
    "scripts:check": "node scripts/check-scripts.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:release": "node --test scripts/test-release-transaction.mjs scripts/test-private-state-recovery.mjs scripts/test-package-verification.mjs",
    "package:verify": "node scripts/verify-package.mjs",
    "research:check": "node scripts/check-ai-drawing-research.mjs",
    "research:qwen": "node scripts/run-qwen-image-benchmark.mjs",
    "research:mechanics": "node scripts/run-mechanics-baseline.mjs",
    "research:artist-strategies": "node scripts/run-board-artist-strategy-baseline.mjs",
    "research:artist-probe": "node scripts/probe-board-artist-provider.mjs",
    "research:artist-live": "node scripts/run-board-artist-live-matrix.mjs",
    "research:artist-summary": "node scripts/summarize-board-artist-live.mjs",
    "install:dev-plugin": "node scripts/install-dev-plugin.mjs",
    "install:vault": "node scripts/build.mjs && node scripts/install-dev-plugin.mjs"
  },
  "devDependencies": {
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@types/node": "^22.15.0",
    "@types/rbush": "^4.0.0",
    "@vitest/coverage-v8": "4.1.8",
    "esbuild": "^0.28.0",
    "happy-dom": "^20.14.0",
    "obsidian": "^1.13.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "@a2a-js/sdk": "1.2.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "fflate": "^0.8.3",
    "perfect-freehand": "^1.2.2",
    "rbush": "^4.0.1",
    "roughjs": "^4.6.6",
    "vanilla-tilt": "^1.8.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  }
}
