{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tutor.local/schemas/ai-drawing-experiment-v1.json",
  "title": "Tutor AI Drawing Experiment Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "taskId", "provider", "model", "promptVersion", "startedAt", "latencyMs", "status", "outputs", "scores"],
  "properties": {
    "format": {"const": "tutor-ai-drawing-experiment-v1"},
    "taskId": {"type": "string"},
    "provider": {"type": "string"},
    "model": {"type": "string"},
    "modelVersion": {"type": "string"},
    "promptVersion": {"type": "string"},
    "seed": {"type": "integer"},
    "startedAt": {"type": "string", "format": "date-time"},
    "latencyMs": {"type": "number", "minimum": 0},
    "peakMemoryMb": {"type": "number", "minimum": 0},
    "costUsd": {"type": "number", "minimum": 0},
    "status": {"enum": ["generated", "accepted", "rejected", "failed", "cancelled"]},
    "failureCode": {"type": "string"},
    "providerRequestId": {"type": "string"},
    "requestedWidth": {"type": "integer", "minimum": 1},
    "requestedHeight": {"type": "integer", "minimum": 1},
    "requestedCount": {"type": "integer", "minimum": 1, "maximum": 6},
    "promptExtend": {"type": "boolean"},
    "promptExtendMode": {"enum": ["direct", "agent"]},
    "thinking": {"type": "boolean"},
    "watermark": {"type": "boolean"},
    "referenceInputs": {"type": "array", "items": {"type": "string"}, "maxItems": 3},
    "outputWidth": {"type": "integer", "minimum": 1},
    "outputHeight": {"type": "integer", "minimum": 1},
    "outputTier": {"type": "string"},
    "outputs": {"type": "array", "items": {"type": "string"}},
    "scores": {"type": "object", "additionalProperties": {"type": "number", "minimum": 1, "maximum": 5}},
    "reviewerNotes": {"type": "string"},
    "authorizedForTraining": {"type": "boolean", "default": false}
  }
}
